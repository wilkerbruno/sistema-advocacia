SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
DB_USER=root
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_advocacia
FLASK_DEBUG=0
PORT=5000

# Chave do cofre de senha de processo (seção 5.1 do briefing).
# Gere uma chave Fernet real antes de usar em produção:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COFRE_SENHA_PROCESSO_KEY=

# API de leitura autenticada para o Data Lake do escritório (seção 12).
# Gere um token forte (ex: python -c "import secrets; print(secrets.token_hex(32))")
# e compartilhe só com quem for consumir a API. Sem isso definido, /api/v1/* responde 503.
DATALAKE_API_TOKEN=

# Envio do relatório semanal por e-mail (seção 10). Sem isso preenchido,
# enviar_relatorio_semanal.py gera o relatório mas não tenta enviar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE=
RELATORIO_SEMANAL_DESTINATARIOS=

# Cobrança de licenças via Mercado Pago (Checkout Pro).
# Gere em https://www.mercadopago.com.br/developers/panel — use a credencial
# de PRODUÇÃO só quando o fluxo já estiver validado em sandbox.
MERCADOPAGO_ACCESS_TOKEN=

# Agentes de IA jurídica (Operação/Gestão/Negócios). Roda um modelo local
# de até 2B parâmetros (Qwen2.5-1.5B-Instruct) dentro do próprio servidor —
# não precisa preencher nada aqui pra funcionar. Os pesos são baixados
# automaticamente durante o build da imagem Docker (baixar_modelo_ia_local.py).
# Só mexa nestas variáveis se quiser ajustar performance/memória:
# IA_LOCAL_CONTEXT_SIZE=4096
# IA_LOCAL_MAX_TOKENS_RESPOSTA=700
# IA_LOCAL_THREADS=

# Legado: só necessário se um dia reverter o Agente de IA para usar a API
# da Anthropic (Claude) em vez do modelo local. Gere em
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Captura automática de movimentações processuais via DataJud — API
# pública e GRATUITA do CNJ (cobre todos os tribunais do país: TJs, TRTs,
# TRFs, tribunais superiores). Cadastro individual gratuito em
# https://datajud-wiki.cnj.jus.br/ (não exige OAB/CNPJ). Sem isso definido,
# o cadastro de processo por número CNJ continua funcionando, mas fica
# marcado como "não monitorável automaticamente" em vez de capturar de
# verdade. Não cobre busca por nome/CPF sem já ter o número do processo —
# isso exigiria um provedor pago (Judit/Escavador/Digesto/Codilo).
DATAJUD_API_KEY=

# Lembrete de compromisso da Agenda por WhatsApp (ver app/utils/whatsapp.py
# e a pasta whatsapp-bridge/) — automação NÃO-OFICIAL do WhatsApp Web
# (decisão explícita, ciente do risco de banimento do número usado; NÃO é
# a API paga da Meta). Exige subir o serviço separado whatsapp-bridge/
# (Node.js) como um segundo serviço no EasyPanel e escanear o QR code uma
# vez (rota /qr do bridge) com o WhatsApp do número escolhido pelo
# escritório — use um número dedicado a isso, nunca o pessoal de alguém.
# Sem isso preenchido, o lembrete de compromisso continua saindo por
# notificação no sistema e e-mail normalmente, só o WhatsApp fica desligado.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
