SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
DB_USER=root
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_advocacia
FLASK_DEBUG=0
PORT=5000

# Chave do cofre de senha de processo (seção 5.1 do briefing).
# Gere uma chave Fernet real antes de usar em produção:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COFRE_SENHA_PROCESSO_KEY=

# API de leitura autenticada para o Data Lake do escritório (seção 12).
# Gere um token forte (ex: python -c "import secrets; print(secrets.token_hex(32))")
# e compartilhe só com quem for consumir a API. Sem isso definido, /api/v1/* responde 503.
DATALAKE_API_TOKEN=

# Envio do relatório semanal por e-mail (seção 10). Sem isso preenchido,
# enviar_relatorio_semanal.py gera o relatório mas não tenta enviar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE=
RELATORIO_SEMANAL_DESTINATARIOS=

# Cobrança de licenças via Mercado Pago (Checkout Pro).
# Gere em https://www.mercadopago.com.br/developers/panel — use a credencial
# de PRODUÇÃO só quando o fluxo já estiver validado em sandbox.
MERCADOPAGO_ACCESS_TOKEN=

# Agentes de IA jurídica (Operação/Gestão/Negócios). Sem isso preenchido,
# o chat responde que está indisponível — nunca inventa resposta.
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
