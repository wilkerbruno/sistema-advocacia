# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores
# reais — o .env de verdade NUNCA deve ser commitado no Git (contém um
# token de acesso e a senha do certificado).

# URL do seu JusControl, sem barra no final.
JUSCONTROL_URL=https://minhaempresa.jus-control.com.br

# Token gerado na tela "Meu agente local" dentro do JusControl (aparece
# uma única vez, na hora de gerar — copie assim que gerar).
JUSCONTROL_AGENTE_TOKEN=

# De quanto em quanto tempo (segundos) o agente verifica se há uma busca
# de autos pendente para você.
INTERVALO_POLLING_SEGUNDOS=60

# Certificado digital A1 (.pfx ou .p12) do próprio advogado — o arquivo
# fica só na sua máquina, nunca é enviado para o JusControl.
CERTIFICADO_PFX_CAMINHO=C:\Certificados\meu-certificado.pfx
CERTIFICADO_PFX_SENHA=

# Conector "pje_mni" (piloto — ver conectores/pje_mni.py, AINDA NÃO
# TESTADO CONTRA TRIBUNAL REAL). PJE_URL_WSDL, se preenchida, tem
# prioridade sobre PJE_TRIBUNAL/PJE_INSTANCIA — sempre confirme a URL
# de verdade do WSDL do seu tribunal antes de usar em produção.
PJE_TRIBUNAL=
PJE_INSTANCIA=1g
PJE_ID_CONSULTANTE=
PJE_SENHA_CONSULTANTE=
PJE_URL_WSDL=
